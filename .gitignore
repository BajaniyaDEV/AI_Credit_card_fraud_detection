# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Environment and secrets
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# Local data and generated artifacts
data/raw/*
data/processed/*
models/*
reports/*

# Keep project directories in version control
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!reports/.gitkeep

# Test and tooling caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Operating system and editor files
.DS_Store
Thumbs.db
.vscode/
